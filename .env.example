# Server-side only. The browser never sees these two.
# Address of the API.
API_URL=http://localhost:3001
# The website's own API key (INTERNAL tier). Create it in wastewatch-api with:
#   npx ts-node scripts/issue-web-key.ts
WEB_API_KEY=

# Base map style. Stadia Maps needs a key: add ?api_key=YOUR_KEY to the address.
# This one is public by design (it is sent to the browser), so restrict it to your domains in the Stadia dashboard.
NEXT_PUBLIC_MAP_STYLE=https://tiles.stadiamaps.com/styles/alidade_smooth_dark.json
